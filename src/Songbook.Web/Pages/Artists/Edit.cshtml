@page "{id:int}"
@model Songbook.Web.Pages.Artists.EditModel

<h1>Редактирование артиста</h1>

<form method="post" class="mt-3">
    
    <input type="hidden" asp-for="Artist.Id" />

    <div class="mb-3">
        <label asp-for="Artist.Name" class="form-label"></label>
        <input asp-for="Artist.Name" class="form-control" />
        <span asp-validation-for="Artist.Name" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-primary">Сохранить</button>
    <a asp-page="Details"
       asp-route-id="@Model.Artist.Id"
       class="btn btn-secondary">
        Отмена
    </a>
</form>
