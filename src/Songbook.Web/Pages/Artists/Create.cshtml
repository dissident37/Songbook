@page
@model Songbook.Web.Pages.Artists.CreateModel

<h1>Neuer Interpret</h1>

<form method="post" class="mt-3">
    <!-- Validierungsfehler anzeigen -->
    <div asp-validation-summary="All" class="text-danger"></div>

    <div class="mb-3">
        <label asp-for="Artist.Name" class="form-label">Name</label>
        <input asp-for="Artist.Name" class="form-control" />
        <span asp-validation-for="Artist.Name" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-primary">Speichern</button>
    <a asp-page="Index" class="btn btn-secondary">Abbrechen</a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
