@page "{id:int}"
@model Songbook.Web.Pages.Artists.DeleteModel

<h1>Удалить артиста</h1>

<div class="alert alert-warning">
    Вы уверены, что хотите удалить <strong>@Model.Artist.Name</strong>?
</div>

<form method="post">
    <button type="submit" class="btn btn-danger">Удалить</button>
    <a asp-page="Index" class="btn btn-secondary">Отмена</a>
</form>
