@page "{id:int}"
@model Songbook.Web.Pages.Artists.DeleteModel

<h1>Interpret löschen</h1>

<div class="alert alert-warning">
    Sind Sie sicher, dass Sie den Interpreten
    <strong>@Model.Artist.Name</strong> löschen möchten?
</div>

<form method="post">
    <button type="submit" class="btn btn-danger">Löschen</button>
    <a asp-page="Index" class="btn btn-secondary">Abbrechen</a>
</form>
