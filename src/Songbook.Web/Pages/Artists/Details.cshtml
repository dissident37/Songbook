@page "{id:int}"
@model Songbook.Web.Pages.Artists.DetailsModel

<h1 class="mb-3">@Model.Artist.Name</h1>

@if (Model.Artist.Songs.Any())
{
    <h5>Songs</h5>
    <ul class="list-unstyled ms-3">
        @foreach (var song in Model.Artist.Songs)
        {
            <li>
                • <a asp-page="/Songs/Details"
                     asp-route-id="@song.Id"
                     class="text-decoration-none">
                    @song.Title
                </a>
            </li>
        }
    </ul>
}
else
{
    <p class="text-muted">Dieser Interpret hat noch keine Songs.</p>
}

<div class="mt-4 d-flex gap-2">
    @if (User.IsInRole("Admin"))
    {
        <a asp-page="Edit"
           asp-route-id="@Model.Artist.Id"
           class="btn btn-outline-secondary">
            ✏ Interpret bearbeiten
        </a>

        <a asp-page="Delete"
           asp-route-id="@Model.Artist.Id"
           class="btn btn-outline-danger">
            🗑 Interpret löschen
        </a>
    }

    <a asp-page="Index"
       class="btn btn-secondary ms-auto">
        ← Zurück zur Künstlerliste
    </a>
</div>
