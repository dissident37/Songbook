@page
@model Songbook.Web.Pages.Artists.IndexModel

<h1 class="mb-4">Interpreten</h1>
<p class="text-muted">
    Wählen Sie einen Interpreten aus, um die Songs anzuzeigen.
</p>

@if (!Model.Artists.Any())
{
    <p>Keine Interpreten gefunden.</p>
}
else
{
    <ul class="list-group">
        @foreach (var artist in Model.Artists)
        {
            <li class="list-group-item d-flex justify-content-between align-items-center">
                <a asp-page="Details"
                   asp-route-id="@artist.Id"
                   class="fw-bold text-decoration-none">
                    @artist.Name
                </a>

                <span class="text-muted">
                    @artist.Songs.Count Songs
                </span>
            </li>
        }
    </ul>
}

<hr />

@if (User.IsInRole("Admin"))
{
    <a asp-page="Create" class="btn btn-sm btn-outline-secondary">
        ➕ Interpreten hinzufügen
    </a>
}
