@page
@model Songbook.Web.Pages.IndexModel

<h1>Songs</h1>

<p>
    <a class="btn btn-primary" asp-page="/Songs/Create">Add Song</a>
</p>

<table class="table">
    <thead>
        <tr>
            <th>Title</th>
            <th>Artist</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var song in Model.Songs)
{
        <tr>
            <td>@song.Title</td>
            <td>@song.Artist?.Name</td>
            <td>
                <a asp-page="/Songs/Details" asp-route-id="@song.Id">View</a> |
                <a asp-page="Edit" asp-route-id="@song.Id">Edit</a> |
                <a asp-page="Delete" asp-route-id="@song.Id">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
