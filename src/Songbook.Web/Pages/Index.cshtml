@page
@model Songbook.Web.Pages.IndexModel
@inject Microsoft.AspNetCore.Mvc.Localization.IViewLocalizer T

<div class="py-4">
    <h1 class="mb-3">@T["Title"]</h1>

    <p class="lead">
        @T["LeadText"]
    </p>

    <a class="btn btn-primary" asp-page="/Artists/Index">
        @T["GoToArtists"]
    </a>
</div>
