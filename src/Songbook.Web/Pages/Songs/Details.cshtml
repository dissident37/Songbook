@page "{id:int}"
@model Songbook.Web.Pages.Songs.DetailsModel

<h1 class="mb-1">@Model.Song.Title</h1>

<p class="text-muted mb-4">
    Исполнитель:
    <a asp-page="/Artists/Details"
       asp-route-id="@Model.Song.Artist.Id"
       class="text-decoration-none fw-semibold">
        @Model.Song.Artist.Name
    </a>
</p>

<pre class="song-text">
@Model.Song.Content
</pre>

<div class="mt-4 d-flex gap-2">
    <a asp-page="Edit"
       asp-route-id="@Model.Song.Id"
       class="btn btn-outline-primary">
        ✏ Редактировать
    </a>

    <a asp-page="Delete"
       asp-route-id="@Model.Song.Id"
       class="btn btn-outline-danger">
        🗑 Удалить
    </a>

    <a asp-page="/Songs/Index"
       class="btn btn-secondary ms-auto">
        ← Назад к списку песен
    </a>
</div>
