@page "{id:int}"
@model Songbook.Web.Pages.Songs.DetailsModel
@inject Microsoft.AspNetCore.Mvc.Localization.IViewLocalizer T

<h1 class="mb-1">@Model.Song.Title</h1>

<p class="text-muted mb-4">
    @T["ArtistLabel"]:
    <a asp-page="/Artists/Details"
       asp-route-id="@Model.Song.Artist.Id"
       class="text-decoration-none fw-semibold">
        @Model.Song.Artist.Name
    </a>
</p>

@if (Model.IsAdmin)
{
    <p class="text-muted mb-4">
        @T["OwnerLabel"]:
        <span class="fw-semibold">@(Model.Song.CreatedByUser?.DisplayName ?? Model.Song.CreatedByUserId?.ToString() ?? "-")</span>
    </p>

    @if (Model.Song.IsHiddenByAdmin)
    {
        <div class="alert alert-warning py-2">
            <div>
                <strong>@T["ModerationStatusLabel"]:</strong>
                @T["HiddenBadge"]
            </div>
            @if (!string.IsNullOrWhiteSpace(Model.Song.HiddenReason))
            {
                <div>
                    <strong>@T["HiddenReasonLabel"]:</strong>
                    @Model.Song.HiddenReason
                </div>
            }
        </div>
    }
}

<div class="song-layout">

    <div class="song-body">
        <pre class="song-text">@Model.RenderContent()</pre>
    </div>

    @if (Model.SongChordNames.Any())
    {
        <aside class="chord-panel" id="chord-panel">
            <div class="chord-panel-title">Аккорды</div>

            @foreach (var name in Model.SongChordNames)
            {
                var groupId = "cg-" + Uri.EscapeDataString(name);
                <div class="chord-group" id="@groupId" data-chord="@name">
                    <div class="chord-group-name">@name</div>
                    @if (Model.ChordDiagrams.TryGetValue(name, out var diagrams))
                    {
                        foreach (var chord in diagrams)
                        {
                            <div class="chord-card">
                                <img src="/@chord.ImagePath"
                                     alt="@name"
                                     class="chord-img"
                                     loading="lazy" />
                            </div>
                        }
                    }
                    else
                    {
                        <div class="chord-card chord-card--no-image">
                            <span>@name</span>
                        </div>
                    }
                </div>
            }
        </aside>
    }

</div>

<div class="mt-4 d-flex gap-2">
    <a asp-page="Edit"
       asp-route-id="@Model.Song.Id"
       class="btn btn-outline-primary">
        @T["Edit"]
    </a>

    <a asp-page="Delete"
       asp-route-id="@Model.Song.Id"
       class="btn btn-outline-danger">
        @T["Delete"]
    </a>

    <a asp-page="/Songs/Index"
       class="btn btn-secondary ms-auto">
        @T["BackToList"]
    </a>
</div>
