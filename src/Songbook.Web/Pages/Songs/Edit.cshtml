@page "{id:int}"
@model Songbook.Web.Pages.Songs.EditModel

<h1>Edit Song</h1>

<form method="post">
    <div class="mb-3">
        <label>Title</label>
        <input class="form-control" asp-for="Input.Title" />
    </div>

    <div class="mb-3">
        <label>Artist</label>
        <input class="form-control" asp-for="Input.ArtistName" />
    </div>

    <div class="mb-3">
        <label>Content (with chords)</label>
        <textarea class="form-control" rows="10" asp-for="Input.Content"></textarea>
    </div>

    <div class="form-check mb-3">
        <input class="form-check-input" asp-for="Input.IsPublic" />
        <label class="form-check-label" asp-for="Input.IsPublic">
            Öffentlich (für alle sichtbar)
        </label>
    </div>


    <button type="submit" class="btn btn-primary">Save</button>
    <a asp-page="Index" class="btn btn-secondary">Cancel</a>
</form>