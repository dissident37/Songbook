@page "{id:int}"
@model Songbook.Web.Pages.Songs.EditModel

<h1>Edit Song</h1>

<form method="post">
    <div>
        <label>Title</label>
        <input asp-for="Song.Title" />
    </div>

    <div>
        <label>Artist</label>
        <input asp-for="Song.Artist" />
    </div>

    <div>
        <label>Lyrics</label>
        <textarea asp-for="Song.Lyrics"></textarea>
    </div>

    <div>
        <label>Chords</label>
        <textarea asp-for="Song.Chords"></textarea>
    </div>

    <button type="submit">Save</button>
</form>

<a asp-page="Index">Back to list</a>
