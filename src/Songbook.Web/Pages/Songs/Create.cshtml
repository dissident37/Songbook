@page
@model Songbook.Web.Pages.Songs.CreateModel

<h1>Добавить песню</h1>

<form method="post">

    <!-- ИСПОЛНИТЕЛЬ (ВСЕГДА В DOM) -->
    <div class="mb-3 position-relative">
        <label class="form-label">Исполнитель</label>

        <input type="text"
               class="form-control"
               id="artistInput"
               name="Input.ArtistName"
               autocomplete="off" />

        <input type="hidden"
               id="artistIdInput"
               name="Input.SelectedArtistId" />

        <ul class="list-group position-absolute w-100"
            id="artistSuggestions"
            style="z-index:1000; display:none; max-height:240px; overflow:auto;">
        </ul>
    </div>

    <!-- НАЗВАНИЕ ПЕСНИ -->
    <div class="mb-3">
        <label class="form-label">Название песни</label>
        <input class="form-control" asp-for="Input.Title" />
    </div>

    <!-- ТЕКСТ -->
    <div class="mb-3">
        <label class="form-label">Текст (с аккордами)</label>
        <textarea class="form-control"
                  rows="10"
                  asp-for="Input.Content"></textarea>
    </div>

    <button type="submit" class="btn btn-primary">Сохранить</button>
    <a asp-page="/Songs/Index" class="btn btn-secondary">Отмена</a>
</form>

<script>
document.addEventListener("DOMContentLoaded", () => {

    const input = document.getElementById("artistInput");
    const list = document.getElementById("artistSuggestions");
    const artistIdInput = document.getElementById("artistIdInput");

    if (!input || !list || !artistIdInput) return;

    let timer = null;

    input.addEventListener("input", () => {
        const term = input.value.trim();
        artistIdInput.value = "";

        clearTimeout(timer);

        if (term.length < 2) {
            list.style.display = "none";
            list.innerHTML = "";
            return;
        }

        timer = setTimeout(async () => {
            const response = await fetch(
                `?handler=SearchArtists&term=${encodeURIComponent(term)}`
            );

            if (!response.ok) {
                list.style.display = "none";
                return;
            }

            const artists = await response.json();
            list.innerHTML = "";

            if (!artists || artists.length === 0) {
                list.style.display = "none";
                return;
            }

            artists.forEach(a => {
                const item = document.createElement("li");
                item.className = "list-group-item list-group-item-action";
                item.textContent = a.name;

                item.addEventListener("click", () => {
                    input.value = a.name;
                    artistIdInput.value = a.id;
                    list.style.display = "none";
                    list.innerHTML = "";
                });

                list.appendChild(item);
            });

            list.style.display = "block";
        }, 200);
    });

    document.addEventListener("click", (e) => {
        if (!list.contains(e.target) && e.target !== input) {
            list.style.display = "none";
        }
    });
});
</script>
