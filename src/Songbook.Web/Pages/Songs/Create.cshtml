@page
@model Songbook.Web.Pages.Songs.CreateModel

<h1>Create Song</h1>

<form method="post">
    <div class="mb-3">
        <label class="form-label">Title</label>
        <input class="form-control" asp-for="Input.Title" />
    </div>

    <div class="mb-3">
        <label class="form-label">Artist</label>
        <input class="form-control" asp-for="Input.ArtistName" />
    </div>

    <div class="mb-3">
        <label class="form-label">Content (with chords)</label>
        <textarea class="form-control" rows="10" asp-for="Input.Content"></textarea>
    </div>

    <button type="submit" class="btn btn-primary">Save</button>
    <a asp-page="Index" class="btn btn-secondary">Cancel</a>
</form>
