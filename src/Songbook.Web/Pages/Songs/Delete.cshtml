@page "{id:int}"
@model Songbook.Web.Pages.Songs.DeleteModel
@inject Microsoft.AspNetCore.Mvc.Localization.IViewLocalizer T

<h1>@T["Title"]</h1>

<h3>@T["DeleteConfirm"]</h3>

<div>
    <strong>@T["TitleLabel"]:</strong> @Model.Song.Title
</div>
<div>
    <strong>@T["ArtistLabel"]:</strong> @Model.Song.Artist
</div>

<form method="post">
    <input type="hidden" asp-for="Song.Id" />
    <button type="submit">@T["Delete"]</button>
    <a asp-page="Index">@T["Cancel"]</a>
</form>
