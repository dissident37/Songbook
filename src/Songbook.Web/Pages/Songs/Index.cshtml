@page
@model Songbook.Web.Pages.Songs.SongIndexModel

<h1>Songs</h1>

<table class="table">
    <thead>
        <tr>
            <th>Title</th>
            <th>Artist</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var song in Model.SongList)
{
        <tr>
            <td>@song.Title</td>
            <td>@song.Artist</td>
            <td>
                <a asp-page="Edit" asp-route-id="@song.Id">Edit</a> |
                <a asp-page="Delete" asp-route-id="@song.Id">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>

<a asp-page="Create">Add Song</a>
