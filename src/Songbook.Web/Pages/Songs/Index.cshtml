@page
@model Songbook.Web.Pages.Songs.SongIndexModel
@inject Microsoft.AspNetCore.Mvc.Localization.IViewLocalizer T

<h1 class="mb-3">@T["Title"]</h1>

<table class="table table-hover">
    <thead>
        <tr>
            <th>@T["SongColumn"]</th>
            <th>@T["ArtistColumn"]</th>
        </tr>
    </thead>
    <tbody>
@foreach (var song in Model.SongList)
{
        <tr>
            <td>
                <a asp-page="Details"
                   asp-route-id="@song.Id"
                   class="fw-semibold text-decoration-none">
                    @song.Title
                </a>
            </td>
            <td>
                <a asp-page="/Artists/Details"
                   asp-route-id="@song.Artist.Id"
                   class="fw-semibold text-decoration-none">
                @song.Artist.Name
                </a>
            </td>
        </tr>
}
    </tbody>
</table>

<a asp-page="Create" class="btn btn-primary">@T["AddSongButton"]</a>
