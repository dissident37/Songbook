@page
@model Songbook.Web.Pages.Songs.SongIndexModel

<h1 class="mb-3">Песни</h1>

<table class="table table-hover">
    <thead>
        <tr>
            <th>Песня</th>
            <th>Исполнитель</th>
        </tr>
    </thead>
    <tbody>
@foreach (var song in Model.SongList)
{
        <tr>
            <td>
                <a asp-page="Details"
                   asp-route-id="@song.Id"
                   class="fw-semibold text-decoration-none">
                    @song.Title
                </a>
            </td>
            <td>
                <a asp-page="/Artists/Details"
                   asp-route-id="@song.Artist.Id"
                   class="fw-semibold text-decoration-none">
                @song.Artist.Name
                </a>
            </td>
        </tr>
}
    </tbody>
</table>

<a asp-page="Create" class="btn btn-primary">➕ Добавить песню</a>
