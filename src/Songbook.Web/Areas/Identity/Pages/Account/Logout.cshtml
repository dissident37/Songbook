@page
@model LogoutModel
@inject Microsoft.AspNetCore.Mvc.Localization.IViewLocalizer T
@inject Microsoft.Extensions.Localization.IStringLocalizer<SharedResource> L
@{
    ViewData["Title"] = T["Title"].Value;
}

<div class="row justify-content-center mt-4">
    <div class="col-12 col-sm-8 col-md-6 col-lg-5 text-center">

        <h1 class="mb-4">@T["Title"]</h1>
        <p class="text-muted mb-4">@T["Message"]</p>

        <a asp-page="/Index" class="btn btn-primary">@T["HomeButton"]</a>

    </div>
</div>
